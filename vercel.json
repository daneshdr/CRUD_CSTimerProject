{
  "version": 2,
  "functions": {
    "index.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "actions/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "^/config/.*",
      "status": 403
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/actions/(.*)",
      "dest": "/actions/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}