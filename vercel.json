{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "actions/*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/config/.*",
      "status": 403
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/actions/(.*)",
      "dest": "/actions/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}